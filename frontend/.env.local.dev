# cp .env.local.dev .env.local
#
# Dev points straight at the FastAPI server. Port 8001, not 8000: on this machine port
# 8000 is held by an unrelated project's api-service container. The server's
# CORS_ALLOWED_ORIGINS already defaults to http://localhost:3000, which is where
# `npm run dev` serves — no server-side env change needed.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
