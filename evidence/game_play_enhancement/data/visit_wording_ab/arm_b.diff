+import re
+
+# Visit-wording A/B (arm B): records and announcements stored by games played on the "visit"
+# wording, rewritten into the "targeted" wording as they are rendered (night_record.py templates).
+_RETARGET = [
+    (re.compile(r"Tonight (player_\d+) was visited by "), r"Tonight \1 was targeted by "),
+    (re.compile(r"No one visited (player_\d+) tonight\."), r"No one targeted \1 tonight."),
+    (re.compile(r"Tonight (player_\d+) visited "), r"Tonight \1 targeted "),
+    (re.compile(r"(player_\d+) visited no one tonight\."), r"\1 targeted no one tonight."),
+    (re.compile(r"(watched player_\d+; saw (?:player_\d+(?:, | and )?)+) visit them"), r"\1 target them"),
+    (re.compile(r"followed (player_\d+); they visited "), r"tracked \1; they targeted "),
+]
+
+
+def retarget(text: str) -> str:
+    """Old "visit" wording in an engine-written text, as the "targeted" wording."""
+    for pattern, repl in _RETARGET:
+        text = pattern.sub(repl, text)
+    return text
+
 
